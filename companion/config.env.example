# Copy this file to ~/.cursor/hooks/config.env (next to notify-oled.py)
# and replace the address with the IP the OLED shows at boot.
#
#   cp config.env.example ~/.cursor/hooks/config.env
#
# The script also honors an already-set ESP32_FACE_URL, and
# ~/.cursor/oled-face.env if config.env is missing.

ESP32_FACE_URL=http://ESP32_IP_HERE/notify

# Optional. Replaces the bottom line for a normal completed turn.
# Error turns still say "Hit a snag", and aborted turns still say "Stopped".
# FACE_TEXT=New reply
